---
import Layout from "../../layouts/Layout.astro";
import config from "@data/config.json";
import { getCollection } from "astro:content";

const allHotTips = await getCollection("hotTips");
---

<Layout title={`Hot Tips | ${config.businessName}`}>
  <section class="max-w-5xl mx-auto px-4 my-32 max-md:my-16">
    <h1 class="text-4xl font-bold text-gray-800 mb-8">🔥 Hot Tips</h1>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        allHotTips.map((tip) => (
          <article class="bg-white rounded-2xl shadow-md hover:shadow-lg transition-shadow p-6 border border-gray-100">
            <h2 class="text-xl font-semibold text-gray-900 mb-3">
              <a href={`/hot-tips/${tip.id}/`} class="hover:text-blue-600">
                {tip.data.title
                  .split(" ")
                  .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
                  .join(" ")}
              </a>
            </h2>
            <p class="text-gray-600 text-sm line-clamp-3 mb-4">
              {new Date(tip.data.date).toLocaleDateString("en-US", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </p>
            <a
              href={`/hot-tips/${tip.id}/`}
              class="text-blue-600 font-medium hover:underline text-sm"
            >
              Read more →
            </a>
          </article>
        ))
      }
    </div>
  </section>
</Layout>
